# Copy this file to .env and fill in the values
# NOTE: Use single quotes if your value contains special characters: PASSWORD='p@ss!'

# ----------------------------
# Backend
# ----------------------------

SPRING_PROFILES_ACTIVE=prod

# DB credentials
# URL must use the TCPS descriptor form so Oracle JDBC applies the wallet for SSL trust.
# Using @//host:port/service bypasses the wallet and causes PKIX certificate errors.
SPRING_DATASOURCE_URL='jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCPS)(HOST=hostname)(PORT=port))(CONNECT_DATA=(SERVICE_NAME=YOUR_SERVICE_NAME)))'
SPRING_DATASOURCE_USERNAME=''
SPRING_DATASOURCE_PASSWORD=''

# Backend JWT validation.
#
# Required only for real CSS authentication. No browser client secret.
CSP_OIDC_ISSUER_URI=
CSP_OIDC_CLIENT_ID=

JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport

# Backend mock auth — pairs with the frontend's local mock auth, which is the
# default on localhost until frontend/.env configures CSS.
# Required for local dev with the prod profile (which sets mock auth off in
# application.yml; this env var overrides it, as env vars outrank profile YAML).
# Without it every API call is rejected with 401. Set to false for real CSS auth.
AUTH_MOCK_ENABLED=true
# Default mock user: its identity provider (idir or bceidbusiness) and FAM role
# codes, comma-separated, mapped exactly as a real token's are (CspAuthorities.java).
# ADMIN, APPROVE and VIEW are shorthand for CSP_ADMIN, CSP_APPROVE and CSP_VIEW.
# A Business BCeID submitter is, for example:
#   AUTH_MOCK_IDENTITY_PROVIDER=bceidbusiness
#   AUTH_MOCK_ROLES=CSP_SUBMITTER_FOREST_CLIENT-00000001
# The UI's mock role selector overrides both per request.
AUTH_MOCK_IDENTITY_PROVIDER=idir
AUTH_MOCK_ROLES=ADMIN

# Serve Swagger UI and the OpenAPI document. Local development only: deployed
# environments never set it, so the docs don't exist there. Like every /api
# path they need a staff role, which the default mock user has.
API_DOCS_ENABLED=true

# ----------------------------
# Frontend
# ----------------------------
# The frontend uses local mock auth by default. For real DEV login, copy
# frontend/.env.example to frontend/.env (git-ignored) and set VITE_OIDC_* to the
# same issuer/client as CSP_OIDC_* above. Register localhost root and
# /authCallback on the DEV CSS client. Keep database credentials in ignored .env.
