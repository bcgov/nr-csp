# Copy to frontend/.env (git-ignored) for real CSS sign-in on localhost. Without
# the issuer and client ID the dev server uses local mock authentication.
# Register http://localhost:3000/authCallback and logout http://localhost:3000/
# on the DEV client. Public client: no client secret.
VITE_OIDC_ISSUER_URI=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
VITE_OIDC_CLIENT_ID=
# Optional overrides; the defaults are shown.
# VITE_OIDC_IDIR_HINT=azureidir
# VITE_OIDC_BCEID_HINT=bceidbusiness
# VITE_OIDC_SITEMINDER_LOGOUT_URL=https://logontest7.gov.bc.ca/clp-cgi/logoff.cgi
