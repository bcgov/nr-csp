{
	# Runtime log verbosity; driven by the LOG_LEVEL env var set in
	# openshift.deploy.yml (DEBUG, INFO, WARN, ERROR). Defaults to INFO.
	log {
		level {$LOG_LEVEL:INFO}
	}
}

:3000 {
	encode zstd gzip

	handle /health {
		respond 200
	}

	handle /api/* {
		# NOTE: deliberately NOT stripping the backend's security headers here.
		# Spring Security sets its own CSP/X-Frame-Options/X-Content-Type-Options
		# (plus HSTS when it sees X-Forwarded-Proto: https), but the site-level
		# `header` block below uses SET semantics and replaces them on the way
		# out. Measured against this backend with the edge router's forwarded
		# headers (-H 'X-Forwarded-Proto: https'), on Caddy 2.7.6, 2.8.4 and
		# 2.11.4: /api/* carries exactly one of each, and it is Caddy's value
		# (Spring's HSTS renders `max-age=31536000 ; includeSubDomains`, with a
		# space before the semicolon — a quick way to tell whose value won).
		#
		# Do NOT read that as a general guarantee that a Caddy SET always
		# collapses an upstream's copy: against a stub upstream that replies
		# HTTP/1.0 with no Content-Length, this same config emitted TWO of each.
		# Whether Set replaces or appends depends on the upstream's response, so
		# re-measure here rather than assuming if the backend's stack changes.
		#
		# A `header_down -Strict-Transport-Security` style strip looks like the
		# obvious dedupe but is a REGRESSION: it removes Caddy's own value too
		# and leaves /api/* with no CSP, no HSTS and no frame/content-type
		# protection at all. That holds even with the strip moved into this
		# proxy block and the header block marked `defer` — measured: /api/*
		# CSP:0 HSTS:0 while the static SPA responses keep theirs.
		reverse_proxy {$BACKEND_URL}
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}

	header {
		# NOTE: do NOT add `-Server` (or any other deletion) to this block. A
		# header block containing a deletion stops its SET operations reaching
		# reverse-proxied responses: with `-Server` present, /api/* loses both
		# Content-Security-Policy and Strict-Transport-Security entirely
		# (verified on Caddy 2.11.4). The Server header discloses no version, so
		# there is nothing to gain by risking it.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# TLS terminates at the OpenShift edge router, so set HSTS here at the
		# edge-facing layer; this covers the static SPA responses and the
		# reverse-proxied /api/* responses alike. 1 year, matches the backend.
		#
		# (Correcting an earlier note here: Spring's HSTS is NOT simply dormant.
		# The backend runs `forward-headers-strategy: framework`, so once it sees
		# X-Forwarded-Proto: https it treats the request as secure and emits its
		# own HSTS — `max-age=31536000 ; includeSubDomains`, note the space before
		# the semicolon. This block's SET replaces it, which is why only one
		# reaches the browser and why it is Caddy's value.)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# form-action is listed explicitly because it is one of the directives
		# that does NOT fall back to default-src — without it the policy places
		# no restriction at all on where a form may submit. The SPA posts no HTML
		# forms (API calls are fetch/XHR and the Amplify sign-in/sign-out flow is
		# GET redirects), so 'self' costs nothing.
		#
		# connect-src covers two Cognito hosts the SPA calls via fetch/XHR:
		# {$COGNITO_DOMAIN} for the hosted-UI OAuth token exchange, and the
		# regional cognito-idp API for Amplify's silent token refresh once the
		# short-lived access/ID token expires — without it, the browser blocks
		# the refresh call and the user gets bounced to sign-in every ~5 min.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://{$COGNITO_DOMAIN} https://cognito-idp.{$COGNITO_REGION}.amazonaws.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
	}
}
