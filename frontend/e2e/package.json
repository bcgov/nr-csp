{
  "name": "nr-e2e-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + playwright-bdd end-to-end tests for a BC Gov Natural Resources web app, authored from Gherkin. Self-contained so it can be lifted into the app repo later.",
  "type": "module",
  "scripts": {
    "bddgen": "bddgen test",
    "pretest": "npm run bddgen",
    "test": "playwright test --project=chromium",
    "pretest:headed": "npm run bddgen",
    "test:headed": "playwright test --project=chromium --headed",
    "pretest:ui": "npm run bddgen",
    "test:ui": "playwright test --project=chromium --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:3000",
    "test:deployed": "playwright test --project=deployed"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "dotenv": "^16.4.5",
    "playwright-bdd": "^9.2.0"
  }
}
